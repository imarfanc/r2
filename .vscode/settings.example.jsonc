{
  // ╭─────────────────────────── UI Layout ────────────────────────────╮
  //"window.zoomLevel": 1,    // Scale entire UI (including explorer font)
  //"workbench.editor.showTabs": "none",
  "window.commandCenter": true,
  // "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "top",
  "workbench.secondarySideBar.showLabels": false,
  "workbench.panel.showLabels": false,
  "explorer.confirmDelete": false,
  "explorer.confirmPasteNative": false,
  "explorer.confirmDragAndDrop": false,

  // ╭────────── Icons ──────────╮
  "workbench.iconTheme": "material-icon-theme",
  "material-icon-theme.activeIconPack": "none",
  "material-icon-theme.folders.associations": {
    ".codex": "Other",
    ".opencode": "Other",
    "ephemeral": "Temp",
    "docs2": "Wakatime",
    "wiki": "Wakatime",
    "plans": "Rules",
    "chat": "",
    ".vt": "Vue",
    "VAL-TOWN": "Vue",
    "CHROME": "Cloudflare",
    "HERE-NOW": "Helm",
    "html-browser": "Helm",
    "__MAIN": "Home",
    "collections": "Tasks",
    "deno-deploy": "Delta",
    "fresh2": "Delta"
  },

  // ╭──────────────────────── Editor Configuration ────────────────────╮
  // "editor.fontSize": 10,
  "editor.fontSize": 12,
  // "editor.fontSize": 14,
  "editor.fontFamily": "Hack Nerd Font Mono",
  "editor.accessibilitySupport": "off",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.defaultFormatter": "denoland.vscode-deno",
  "prettier.configPath": ".prettierrc.json",
  "prettier.enableDebugLogs": true,
  "prettier.resolveGlobalModules": false,
  "prettier.requireConfig": true,
  "prettier.bracketSameLine": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "*.css": "tailwindcss"
  },

  // ╭──────────────────────── Terminal Configuration ────────────────────╮
  "terminal.integrated.lineHeight": 1,
  // "terminal.integrated.fontSize": 10,
  "terminal.integrated.fontSize": 12,
  // "terminal.integrated.fontSize": 14,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.tabs.location": "left",
  "terminal.integrated.tabs.hideCondition": "never",
  "terminal.integrated.fontFamily": "MesloLGS Nerd Font",

  // ╭──────────────────────── Git Configuration ────────────────────╮
  "git.enableSmartCommit": false,
  "git.autofetch": true,

  // ╭──────────────────────── Language blocks ────────────────────╮
  "[markdown]": {
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false,
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },

  // ╭──────────────────────── Language tools ────────────────────╮
  // deno
  "deno.enable": true,
  "deno.config": "./deno.json",
  "deno.lint": true,
  "deno.format": true,
  // markdown
  "markdown-preview-enhanced.previewTheme": "one-dark.css",
  "markdownlint.config": {
    "MD033": {
      "allowed_elements": [
        "a",
        "img",
        "strong",
        "table",
        "tr",
        "th",
        "td",
        "style",
        "em",
        "p",
        "ul",
        "ol",
        "li",
        "blockquote",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ]
    }
  },
  "markdownlint.focusMode": false,
  // python
  "python.defaultInterpreterPath": "/Users/arfan/miniconda3/bin/python",
  // go
  "go.toolsManagement.autoUpdate": true,
  // svelte
  "svelte.enable-ts-plugin": true,

  // ╭──────────────────────── Remote Development ────────────────────╮
  // "remote.SSH.remotePlatform": {
  //   "sandbox.fzrjrx.csb": "linux"
  // },

  // ╭──────────────────────── Theme ────────────────────╮
  // "workbench.preferredDarkColorTheme": "Kimbie Dark",
  // "workbench.preferredLightColorTheme": "Kimbie Dark",
  "workbench.preferredDarkColorTheme": "Solarized Dark",
  // "workbench.preferredLightColorTheme": "Solarized Light",
  "workbench.preferredLightColorTheme": "Tomorrow Night Blue",
  // "workbench.colorTheme": "Default High Contrast",
  // "workbench.colorTheme": "Tomorrow Night Blue",
  // "workbench.colorTheme": "Red",
  "workbench.colorCustomizations": {}
  // ╭──────────────────────── MCP Servers ────────────────────╮
  // "mcp": {
  //   "mcpServers": {
  //     "chrome-devtools": {
  //       "command": "npx",
  //       "args": ["-y", "chrome-devtools-mcp@latest"]
  //     }
  //   }
  // }
}
// ╰───────────────────────────────────────────────────────────────────╯
