# Copy to .env and add only values this project needs.
# Never commit credentials or other secrets.

# PORT=8000

# Set to 0 to silence per-request logging.
# LOG_REQUESTS=1

# Which frontend version `/` serves: v1 or v2.
# FRONTEND=v1

# Shell command the "open" action launches for a script's entry point.
# EDITOR_COMMAND=cursor
