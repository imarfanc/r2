{
  "lock": true,
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.16",
    "@std/cli": "jsr:@std/cli@1.0.32",
    "@std/path": "jsr:@std/path@1.1.3",
    "@tui": "https://deno.land/x/tui@2.1.4/mod.ts",
    "@tui/components": "https://deno.land/x/tui@2.1.4/src/components/mod.ts",
    "@tui/input-types": "https://deno.land/x/tui@2.1.4/src/input_reader/types.ts"
  },
  "tasks": {
    "choose": "deno run -A _repo/tools/choose.ts",
    "check": "deno run -A _repo/tools/check.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "typecheck": "deno run -A _repo/tools/typecheck.ts",
    "test": "deno test -A",
    "skills": "deno run -A _repo/tools/skills.ts",
    "skills:all": "deno run -A _repo/tools/skills.ts --apply",
    "skills:check": "deno run -A _repo/tools/skills.ts --check",
    "skills:links": "deno run -A _repo/tools/skills.ts --links",
    "dev": "deno run -A _repo/tools/dev.ts",
    "dev:open": "deno run -A _repo/tools/dev.ts --open",
    "start": "deno run -A src/main.ts",
    "rename": "deno run -A _repo/tools/rename.ts",
    "git:history": "deno run -A _repo/tools/git-history.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100,
    "proseWrap": "preserve",
    "exclude": [
      "_repo/skills/**/browser-tools/**",
      ".vscode/sessions.json",
      "_other/git/**",
      "data/scripts/**"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "exclude": [
      "_repo/skills/**/browser-tools/**",
      ".vscode/sessions.json",
      "data/scripts/**"
    ]
  }
}
